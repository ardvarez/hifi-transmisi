# Sensitive config files (MCP & Credentials)
assets/mcp-config/tools.yaml
assets/mcp-config/*.yaml
!assets/mcp-config/tools.example.yaml

# Environment & Secret files
.env
.env.*
*.env
*.pem
*.key
*.crt
*.pfx
secrets/
config/secrets*

# Databases & local data
*.db
*.sqlite
*.sqlite3

# Dependency folders & logs
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# Python cache & venv
__pycache__/
*.pyc
venv/
.venv/

# Environment & IDE settings
.vscode/
.idea/
.gemini/
.agents/
*.suo
*.user
